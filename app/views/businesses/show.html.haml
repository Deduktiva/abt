= breadcrumbs ['Configuration', configuration_path], 'Business', action: action_button('Edit', edit_business_path, permission: 'business.edit')

.row
  .col-md-6
    .card
      .card-header
        Company Information
      .card-body
        .row.mb-2
          .col-sm-4
            %strong Short Name:
          .col-sm-8
            = @business.short_name

        .row.mb-2
          .col-sm-4
            %strong Legal Name:
          .col-sm-8
            = @business.legal_name

        .row.mb-2
          .col-sm-4
            %strong VAT ID:
          .col-sm-8
            = @business.vat_id

        .row.mb-2
          .col-sm-4
            %strong Currency:
          .col-sm-8
            = @business.currency

        .row.mb-2
          .col-sm-4
            %strong Money decimal places:
          .col-sm-8
            = @business.money_decimal_places

        .row.mb-2
          .col-sm-4
            %strong Address:
          .col-sm-8
            - @business.address.to_s.split("\n").each do |line|
              %div= line

        .row.mb-2
          .col-sm-4
            %strong Country:
          .col-sm-8
            - if country_unknown?(@business.country_iso2)
              = badge_tag(:warning, 'Not set')
            - else
              = country_name(@business.country_iso2)

  .col-md-6
    .card
      .card-header
        Banking Information
      .card-body
        .row.mb-2
          .col-sm-4
            %strong Bank:
          .col-sm-8
            = @business.bankaccount_bank

        .row.mb-2
          .col-sm-4
            %strong BIC:
          .col-sm-8
            = @business.bankaccount_bic

        .row.mb-2
          .col-sm-4
            %strong Account Number:
          .col-sm-8
            = @business.bankaccount_number

.row.mt-4
  .col-md-6
    .card
      .card-header
        Document Settings
      .card-body
        .row.mb-2
          .col-sm-4
            %strong Contact Line 1:
          .col-sm-8
            %span.text-pre-wrap= @business.document_contact_line1

        .row.mb-2
          .col-sm-4
            %strong Contact Line 2:
          .col-sm-8
            %span.text-pre-wrap= @business.document_contact_line2

        .row.mb-2
          .col-sm-4
            %strong Email From:
          .col-sm-8
            = @business.document_email_from

        .row.mb-2
          .col-sm-4
            %strong Email Reply-To:
          .col-sm-8
            = @business.document_email_reply_to

        .row.mb-2
          .col-sm-4
            %strong Email Auto BCC:
          .col-sm-8
            = @business.document_email_auto_bcc

        .row.mb-2
          .col-sm-4
            %strong Accent Color:
          .col-sm-8
            - if @business.document_accent_color.present?
              %span.badge.badge-issuer-accent
                = @business.document_accent_color
            - else
              %em Not set

        .row.mb-2
          .col-sm-4
            %strong PDF Logo:
          .col-sm-8
            - if @business.pdf_logo.present?
              = badge_tag(:success, 'Logo uploaded')
              - if @business.pdf_logo_width && @business.pdf_logo_height
                %small.text-muted (#{@business.pdf_logo_width}×#{@business.pdf_logo_height})
            - else
              %em No logo set

        .row.mb-2
          .col-sm-4
            %strong PNG Logo:
          .col-sm-8
            - if @business.png_logo.present?
              = image_tag png_logo_business_path, alt: @business.legal_name, class: 'issuer-logo-preview'
            - else
              %em No logo set

  .col-md-6
    .card
      .card-header
        Reporting
      .card-body
        .row.mb-2
          .col-sm-4
            %strong Email for Reports:
          .col-sm-8
            = @business.reporting_email

.row.mt-4
  .col-md-6
    .card
      .card-header
        Invoice Footer
      .card-body
        - if @business.invoice_footer.present?
          = simple_format(@business.invoice_footer)
        - else
          %em No footer text set

  .col-md-6
    .card
      .card-header
        Offer Settings
      .card-body
        .row.mb-2
          .col-sm-4
            %strong Validity:
          .col-sm-8
            = pluralize(@business.offer_validity_days, 'day')

        .row.mb-2
          .col-sm-4
            %strong Offer Footer:
          .col-sm-8
            - if @business.offer_footer.present?
              = simple_format(@business.offer_footer)
            - else
              %em No footer text set
