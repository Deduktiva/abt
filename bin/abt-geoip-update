#!/usr/bin/python3
"""Regenerate the Apache GeoIP allowlist for ABT.

Reads the operator-maintained lists in the config directory (default
/etc/apache2/abt-geoip):

  countries  ISO 3166 alpha-2 codes to allow, whitespace/newline separated
  exempt     IP addresses or CIDR networks that are always allowed

and writes allow.conf next to them: one `Require ip` block covering the
exemptions plus every network the five RIRs list as allocated/assigned to
an allowed country. deploy/apache/abt-app.conf includes allow.conf inside a
<RequireAny> only when it exists, so a host without a countries file is
unrestricted.

The new file is checked with `apache2ctl configtest` before Apache is
reloaded; on failure the previous allow.conf is restored. A failed
download leaves the previous allow.conf untouched.

Run as root (writes under /etc/apache2, reloads apache2). Driven daily by
deploy/apache/abt-geoip-update.timer.
"""

import argparse
import ipaddress
import os
import re
import subprocess
import sys
import tempfile
import urllib.request
from datetime import datetime, timezone

RIR_SOURCES = [
    "https://ftp.afrinic.net/pub/stats/afrinic/delegated-afrinic-extended-latest",
    "https://ftp.apnic.net/stats/apnic/delegated-apnic-extended-latest",
    "https://ftp.arin.net/pub/stats/arin/delegated-arin-extended-latest",
    "https://ftp.lacnic.net/pub/stats/lacnic/delegated-lacnic-extended-latest",
    "https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-extended-latest",
]

COUNTRY_RE = re.compile(r"^[A-Z]{2}$")
NETWORKS_PER_LINE = 16


def die(message):
    print(f"abt-geoip-update: {message}", file=sys.stderr)
    sys.exit(1)


def read_tokens(path):
    """Whitespace-separated tokens, ignoring `#` comments. None if the file is missing."""
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return None
    return [token for line in text.splitlines() for token in line.split("#", 1)[0].split()]


def read_countries(path):
    tokens = read_tokens(path)
    if tokens is None:
        return None
    countries = sorted({token.upper() for token in tokens})
    bad = [c for c in countries if not COUNTRY_RE.match(c)]
    if bad:
        die(f"{path}: not ISO 3166 alpha-2 codes: {' '.join(bad)}")
    return countries


def read_exemptions(path):
    networks = []
    for token in read_tokens(path) or []:
        try:
            networks.append(ipaddress.ip_network(token, strict=True))
        except ValueError as e:
            die(f"{path}: {e}")
    return networks


def fetch(url):
    with urllib.request.urlopen(url, timeout=120) as response:
        return response.read().decode("utf-8", errors="replace")


def parse_delegated(text, countries, found):
    """Yield networks from an RIR delegated-extended file for the given countries."""
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        fields = line.split("|")
        # Skip the version header ("2|ripencc|...") and summary lines ("ripencc|*|ipv4|*|n|summary").
        if len(fields) < 7 or fields[1] == "*":
            continue
        _registry, cc, kind, start, value, _date, status = fields[:7]
        cc = cc.upper()
        if cc not in countries or status not in ("allocated", "assigned"):
            continue
        if kind == "ipv4":
            first = ipaddress.IPv4Address(start)
            last = first + int(value) - 1
            found.add(cc)
            yield from ipaddress.summarize_address_range(first, last)
        elif kind == "ipv6":
            found.add(cc)
            yield ipaddress.IPv6Network(f"{start}/{value}")


def collapse(networks):
    v4 = [n for n in networks if n.version == 4]
    v6 = [n for n in networks if n.version == 6]
    return list(ipaddress.collapse_addresses(v4)) + list(ipaddress.collapse_addresses(v6))


def require_lines(networks):
    for i in range(0, len(networks), NETWORKS_PER_LINE):
        chunk = networks[i:i + NETWORKS_PER_LINE]
        yield "Require ip " + " ".join(str(n) for n in chunk)


def render(countries, exemptions, country_networks, sources):
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    lines = [
        "# Generated by bin/abt-geoip-update — do not edit.",
        "# Edit countries/exempt in this directory and rerun the script instead.",
        f"# Generated: {stamp}",
        f"# Countries: {' '.join(countries)}",
        *(f"# Source: {s}" for s in sources),
        "",
        "# Exemptions",
        *require_lines(collapse(exemptions)),
        "",
        f"# Country networks ({len(country_networks)} prefixes)",
        *require_lines(country_networks),
        "",
    ]
    return "\n".join(lines)


def strip_stamp(content):
    return "\n".join(line for line in content.splitlines() if not line.startswith("# Generated: "))


def run(cmd):
    result = subprocess.run(cmd, capture_output=True, text=True)
    return result.returncode == 0, (result.stdout + result.stderr).strip()


def install(output, content, check, reload):
    """Atomically replace output, roll back if configtest fails, then reload."""
    try:
        with open(output, encoding="utf-8") as f:
            previous = f.read()
    except FileNotFoundError:
        previous = None

    if previous is not None and strip_stamp(previous) == strip_stamp(content):
        print(f"{output} unchanged.")
        return

    write_atomic(output, content)

    if check:
        ok, out = run(["apache2ctl", "configtest"])
        if not ok:
            if previous is None:
                os.unlink(output)
            else:
                write_atomic(output, previous)
            die(f"apache2ctl configtest failed, {output} rolled back:\n{out}")

    print(f"Wrote {output}.")
    if reload:
        ok, out = run(["systemctl", "reload", "apache2"])
        if not ok:
            die(f"systemctl reload apache2 failed:\n{out}")
        print("Reloaded apache2.")


def remove(output, check, reload):
    if not os.path.exists(output):
        return
    os.unlink(output)
    print(f"Removed {output}; GeoIP restriction disabled.")
    if check:
        ok, out = run(["apache2ctl", "configtest"])
        if not ok:
            die(f"apache2ctl configtest failed:\n{out}")
    if reload:
        ok, out = run(["systemctl", "reload", "apache2"])
        if not ok:
            die(f"systemctl reload apache2 failed:\n{out}")


def write_atomic(path, content):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".allow.conf.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def main():
    parser = argparse.ArgumentParser(description="Regenerate the ABT Apache GeoIP allowlist.")
    parser.add_argument("--config-dir", default="/etc/apache2/abt-geoip",
                        help="directory holding countries, exempt and the generated allow.conf")
    parser.add_argument("--source", action="append", metavar="FILE",
                        help="read this RIR delegated file instead of downloading (repeatable)")
    parser.add_argument("--no-configtest", action="store_true", help="skip apache2ctl configtest")
    parser.add_argument("--no-reload", action="store_true", help="do not reload apache2")
    args = parser.parse_args()

    countries_path = os.path.join(args.config_dir, "countries")
    output = os.path.join(args.config_dir, "allow.conf")
    check = not args.no_configtest
    reload = not args.no_reload

    countries = read_countries(countries_path)
    if not countries:
        print(f"No countries configured in {countries_path}; GeoIP restriction is off.")
        remove(output, check, reload)
        return

    exemptions = read_exemptions(os.path.join(args.config_dir, "exempt"))

    sources = args.source or RIR_SOURCES
    wanted = set(countries)
    found = set()
    networks = []
    for source in sources:
        try:
            if args.source:
                with open(source, encoding="utf-8", errors="replace") as f:
                    text = f.read()
            else:
                text = fetch(source)
        except OSError as e:
            die(f"cannot read {source}: {e}; {output} left unchanged")
        networks.extend(parse_delegated(text, wanted, found))

    missing = wanted - found
    if missing:
        die(f"no networks found for {' '.join(sorted(missing))}; {output} left unchanged")

    country_networks = collapse(networks)
    install(output, render(countries, exemptions, country_networks, sources), check, reload)


if __name__ == "__main__":
    main()
