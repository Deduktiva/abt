#!/bin/bash

# Production Update Script for ABT
# Automates the manual deployment process for production environment

set -e # Exit on any error

# Set production environment for all Rails commands
export RAILS_ENV=production

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${BLUE}I:${NC} $1"
}

print_success() {
    echo -e "${GREEN}OK:${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}WARN:${NC} $1"
}

print_error() {
    echo -e "${RED}ERROR:${NC} $1"
}

# Function to check if we're in the correct directory
check_directory() {
    if [[ ! -e .git || ! -d "lib/foptemplate" ]]; then
        print_error "This doesn't appear to be the ABT application root directory."
        print_error "Please run this script from the ABT application root directory."
        exit 1
    fi
}

# Function to check if we're running as the correct user
check_user() {
    print_status "Checking user permissions..."

    local current_user
    current_user=$(whoami)
    print_status "Running as user: $current_user"

    # Check if we can write to the application directory
    if [[ ! -w "." ]]; then
        print_error "Current user ($current_user) doesn't have write permissions to the application directory."
        print_error "Please run this script as the application user."
        exit 1
    fi

    # Check if we can read/write Gemfile.lock
    if [[ -f "Gemfile.lock" && ! -w "Gemfile.lock" ]]; then
        print_error "Cannot write to Gemfile.lock. Please check permissions."
        exit 1
    fi

    print_success "User permission check passed."
}

# Function to update code from git
update_git() {
    print_status "Updating code from Git repository..."

    # Check for uncommitted changes
    if ! git diff --quiet || ! git diff --cached --quiet; then
        print_warning "There are uncommitted changes in the working directory."
        print_warning "Deployment may fail or overwrite local changes."
        read -p "Continue anyway? (y/N): " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            print_error "Deployment cancelled by user."
            exit 1
        fi
    fi

    # Perform git pull with rebase
    if git pull --rebase; then
        print_success "Git update completed successfully."
    else
        print_error "Git pull failed. Please resolve conflicts manually."
        exit 1
    fi
}

# --- Pinned Ruby -----------------------------------------------------------
#
# Production runs the Ruby pinned in .tool-versions, built by the ruby-build
# release pinned as the deploy/ruby-build submodule (Dependabot bumps it).
# Each version lives in its own prefix under RUBIES_DIR; the `current` symlink
# is what the systemd units exec. The symlink only moves after the new Ruby
# is built and the bundle is installed against it.

RUBY_BUILD_DIR="deploy/ruby-build"
# Must match the paths in deploy/systemd/*.service.
RUBIES_DIR="${HOME}/.local/share/abt-ruby"
# Marker written into a prefix once ruby-build finished successfully. A prefix
# without it is a leftover from an interrupted build and gets rebuilt.
RUBY_COMPLETE_MARKER=".abt-build-complete"

# Debian packages ruby-build needs to compile Ruby. libgmp-dev is optional
# (faster bignums); readline is not needed since Ruby 3.3 ships reline.
RUBY_BUILD_DEPS=(build-essential libssl-dev libyaml-dev zlib1g-dev libffi-dev)

RUBY_VERSION_PINNED=""
RUBY_PREVIOUS=""
RUBY_CHANGED=0

read_pinned_ruby_version() {
    RUBY_VERSION_PINNED="$(awk '$1 == "ruby" { print $2 }' .tool-versions 2>/dev/null)"
    if [[ ! "$RUBY_VERSION_PINNED" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        print_error "Could not read a ruby X.Y.Z version from .tool-versions (got '${RUBY_VERSION_PINNED}')."
        exit 1
    fi

    RUBY_PREVIOUS="$(readlink "${RUBIES_DIR}/current" 2>/dev/null || true)"
    if [[ "$RUBY_PREVIOUS" != "$RUBY_VERSION_PINNED" ]]; then
        RUBY_CHANGED=1
    fi
}

check_ruby_build_deps() {
    print_status "Checking Ruby build dependencies..."

    if ! command -v dpkg-query >/dev/null 2>&1; then
        print_warning "dpkg-query not available; cannot verify build dependencies (${RUBY_BUILD_DEPS[*]})."
        return 0
    fi

    local pkg missing=()
    for pkg in "${RUBY_BUILD_DEPS[@]}"; do
        if [[ "$(dpkg-query -W -f='${db:Status-Status}' "$pkg" 2>/dev/null)" != "installed" ]]; then
            missing+=("$pkg")
        fi
    done

    if ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
        missing+=(curl)
    fi

    if ((${#missing[@]} > 0)); then
        print_error "Missing packages needed to build Ruby ${RUBY_VERSION_PINNED}: ${missing[*]}"
        print_error "Ask an administrator to run: sudo apt install ${missing[*]}"
        exit 1
    fi

    print_success "Ruby build dependencies present."
}

update_ruby_build() {
    print_status "Checking out pinned ruby-build..."

    # Picks up URL changes from .gitmodules, then checks out the recorded SHA.
    if git submodule sync --quiet -- "$RUBY_BUILD_DIR" &&
        git submodule update --init --checkout -- "$RUBY_BUILD_DIR"; then
        print_success "ruby-build $(git -C "$RUBY_BUILD_DIR" describe --tags --always 2>/dev/null) checked out."
    else
        print_error "Could not check out the ruby-build submodule."
        exit 1
    fi
}

install_ruby() {
    local prefix="${RUBIES_DIR}/${RUBY_VERSION_PINNED}"

    if [[ -f "${prefix}/${RUBY_COMPLETE_MARKER}" && -x "${prefix}/bin/ruby" ]]; then
        print_success "Ruby ${RUBY_VERSION_PINNED} already installed in ${prefix}."
        return 0
    fi

    check_ruby_build_deps

    if [[ -e "$prefix" ]]; then
        print_warning "Removing incomplete Ruby build in ${prefix}."
        rm -rf -- "$prefix"
    fi

    mkdir -p "$RUBIES_DIR"
    print_status "Building Ruby ${RUBY_VERSION_PINNED} into ${prefix} (takes several minutes)..."

    # ruby-build bakes the prefix into rbconfig and binstub shebangs, so the
    # build goes straight to its final path; the marker guards completeness.
    if RUBY_CONFIGURE_OPTS="--disable-install-doc ${RUBY_CONFIGURE_OPTS:-}" \
        "${RUBY_BUILD_DIR}/bin/ruby-build" "$RUBY_VERSION_PINNED" "$prefix"; then
        touch "${prefix}/${RUBY_COMPLETE_MARKER}"
        print_success "Ruby ${RUBY_VERSION_PINNED} built."
    else
        print_error "ruby-build failed for ${RUBY_VERSION_PINNED}; the running application is untouched."
        exit 1
    fi
}

# Put the pinned Ruby first on PATH for every later step of this deploy.
use_pinned_ruby() {
    export PATH="${RUBIES_DIR}/${RUBY_VERSION_PINNED}/bin:${PATH}"
    hash -r
    print_status "Using $(ruby -v)"
}

setup_ruby() {
    read_pinned_ruby_version
    update_ruby_build
    install_ruby
    use_pinned_ruby
}

# Point the `current` symlink (used by the systemd units) at the pinned Ruby,
# atomically, then drop every installed version except current and previous.
activate_ruby() {
    if ((RUBY_CHANGED == 0)); then
        return 0
    fi

    print_status "Switching ${RUBIES_DIR}/current to Ruby ${RUBY_VERSION_PINNED}..."
    ln -sfn "$RUBY_VERSION_PINNED" "${RUBIES_DIR}/current.new"
    mv -T "${RUBIES_DIR}/current.new" "${RUBIES_DIR}/current"
    print_success "Ruby ${RUBY_VERSION_PINNED} is now current (previous: ${RUBY_PREVIOUS:-none})."

    local dir name
    shopt -s nullglob
    for dir in "${RUBIES_DIR}"/*/; do
        name="$(basename "$dir")"
        [[ -L "${dir%/}" ]] && continue # the current symlink
        if [[ "$name" != "$RUBY_VERSION_PINNED" && "$name" != "$RUBY_PREVIOUS" ]]; then
            print_status "Removing old Ruby ${name}."
            rm -rf -- "${RUBIES_DIR:?}/${name}"
        fi
    done
    shopt -u nullglob
}

# Function to install/update Ruby gems
update_gems() {
    print_status "Installing/updating Ruby gems..."
    bundle config set deployment true
    bundle config set without development:test
    if bundle install; then
        print_success "Bundle install completed successfully."
    else
        print_error "Bundle install failed."
        exit 1
    fi

    # Gems compiled against a different Ruby build (in particular Debian's
    # shared libruby) share the same vendor/bundle ABI directory but won't load
    # under the new interpreter. Recompile every native extension.
    if ((RUBY_CHANGED == 1)); then
        print_status "Ruby changed (${RUBY_PREVIOUS:-system} -> ${RUBY_VERSION_PINNED}); rebuilding gems with bundle pristine..."
        if bundle pristine; then
            print_success "Gems rebuilt for Ruby ${RUBY_VERSION_PINNED}."
        else
            print_error "bundle pristine failed; current Ruby symlink left at ${RUBY_PREVIOUS:-none}."
            exit 1
        fi
    fi
}

# Function to precompile assets
precompile_assets() {
    print_status "Precompiling assets for production..."

    if bundle exec rails assets:precompile; then
        print_success "Asset precompilation completed successfully."
    else
        print_error "Asset precompilation failed."
        exit 1
    fi
}

# Dump the database before migrating. A failed backup aborts the deploy;
# set SKIP_DB_BACKUP=1 to deploy anyway (e.g. when backups are handled by infra).
backup_database() {
    if [[ -n "${SKIP_DB_BACKUP:-}" ]]; then
        print_warning "SKIP_DB_BACKUP is set; skipping the pre-migration database backup."
        return 0
    fi

    print_status "Backing up the database..."

    if bundle exec rails db:backup; then
        print_success "Database backup completed successfully."
    else
        print_error "Database backup failed. Refusing to migrate without a backup."
        print_error "Fix the backup, or re-run with SKIP_DB_BACKUP=1 to proceed regardless."
        exit 1
    fi
}

# Function to run database migrations
migrate_database() {
    print_status "Running database migrations..."

    if bundle exec rails db:migrate; then
        print_success "Database migration completed successfully."
    else
        print_error "Database migration failed."
        exit 1
    fi
}

# systemctl --user needs XDG_RUNTIME_DIR pointing at the user's systemd
# runtime directory. Non-login shells (deploys, cron, scripted ssh) don't
# inherit it from PAM. With `loginctl enable-linger` configured (see
# docs/production-update.md), /run/user/<uid> persists for the user.
ensure_xdg_runtime_dir() {
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
}

systemd_user_reachable() {
    ensure_xdg_runtime_dir
    [[ -S "${XDG_RUNTIME_DIR}/bus" ]]
}

# Install / refresh the systemd user unit symlinks from deploy/systemd/.
# Designed to be resilient: every failure mode warns and continues so a
# partial systemd setup never aborts the rest of the deploy.
install_systemd_units() {
    print_status "Installing/refreshing systemd user unit symlinks..."

    local source_dir
    source_dir="$(pwd)/deploy/systemd"
    local target_dir="${HOME}/.config/systemd/user"

    if [[ ! -d "$source_dir" ]]; then
        print_warning "Source directory $source_dir not found; skipping unit install."
        return 0
    fi

    if ! mkdir -p "$target_dir" 2>/dev/null; then
        print_warning "Could not create $target_dir; skipping unit install."
        return 0
    fi

    local unit_path unit_name target installed=0 skipped=0
    shopt -s nullglob
    for unit_path in "$source_dir"/*.service; do
        unit_name="$(basename "$unit_path")"
        target="$target_dir/$unit_name"

        if [[ -e "$target" && ! -L "$target" ]]; then
            print_warning "$target exists and is not a symlink; leaving it alone (operator may have customized)."
            skipped=$((skipped + 1))
            continue
        fi

        if [[ -d "$target" ]]; then
            # -d on a symlink would follow it (caught above); reaching here means a real directory.
            print_warning "$target is a directory; refusing to replace, skipping $unit_name."
            skipped=$((skipped + 1))
            continue
        fi

        if ! ln -sfn "$unit_path" "$target" 2>/dev/null; then
            print_warning "Failed to symlink $unit_name → $target; continuing."
            skipped=$((skipped + 1))
            continue
        fi

        installed=$((installed + 1))
    done
    shopt -u nullglob

    if ((installed > 0)); then
        print_success "Installed/refreshed $installed unit symlink(s) in $target_dir."
    fi
    if ((skipped > 0)); then
        print_warning "Skipped $skipped unit(s); review warnings above."
    fi

    if systemd_user_reachable; then
        if systemctl --user daemon-reload 2>/dev/null; then
            print_status "Ran systemctl --user daemon-reload."
        else
            print_warning "systemctl --user daemon-reload failed; please run it manually."
        fi
    else
        print_warning "User systemd bus not reachable; skipping daemon-reload (run 'systemctl --user daemon-reload' manually once linger is enabled)."
    fi
}

# Run `systemctl --user <action> <unit>`, tolerating an unreachable bus or a
# unit that isn't installed/enabled yet (warns and returns 0 so the deploy
# doesn't abort on the first cutover). `action` is typically reload or restart.
systemctl_user_action() {
    local unit="$1" action="$2" friendly="$3"

    local gerund past
    case "$action" in
    reload) gerund="Reloading" past="reloaded" ;;
    restart) gerund="Restarting" past="restarted" ;;
    *) gerund="Running ${action} on" past="${action}ed" ;;
    esac

    print_status "${gerund} ${friendly}..."

    if ! command -v systemctl >/dev/null 2>&1; then
        print_warning "systemctl not available; please ${action} ${friendly} manually."
        return 0
    fi

    if ! systemd_user_reachable; then
        print_warning "Cannot reach user systemd: ${XDG_RUNTIME_DIR}/bus is missing."
        print_warning "Ensure 'loginctl enable-linger $(whoami)' has been run (see docs/production-update.md)."
        return 0
    fi

    local cat_output
    if cat_output=$(systemctl --user cat "$unit" 2>&1); then
        if systemctl --user "$action" "$unit"; then
            print_success "${friendly} ${past}."
        else
            print_warning "systemctl --user ${action} ${unit} failed; please ${action} manually."
        fi
    elif echo "$cat_output" | grep -qi "no .*unit\|not loaded\|not.found\|could not be found"; then
        print_warning "${unit} is not installed or not enabled yet; see docs/production-update.md for setup."
    else
        print_warning "systemctl --user cat ${unit} failed:"
        echo "$cat_output" | sed 's/^/    /'
    fi
}

# Hot-restart Puma via systemctl reload (ExecReload sends SIGUSR2). A hot
# restart re-execs the Ruby binary the master is already running, so a Ruby
# change needs a full restart to pick up the new interpreter.
restart_puma() {
    if ((RUBY_CHANGED == 1)); then
        systemctl_user_action abt-puma.service restart "Puma application server (Ruby changed)"
    else
        systemctl_user_action abt-puma.service reload "Puma application server"
    fi
}

restart_jobs_worker() {
    systemctl_user_action abt-jobs.service restart "Solid Queue jobs worker"
}

# Main deployment function
main() {
    echo "========================================"
    echo "    ABT Production Deployment Script    "
    echo "========================================"
    echo

    # Perform all checks and deployment steps
    check_directory
    check_user
    update_git
    setup_ruby
    update_gems
    install_systemd_units
    precompile_assets
    backup_database
    migrate_database
    activate_ruby
    restart_puma
    restart_jobs_worker

    echo
    print_success "Production deployment completed successfully!"
    echo
    print_status "The application should now be running the latest version."
}

# Run the deployment
main "$@"
